# URL publique du site (balises canonical, Open Graph, sitemap).
# Sur Vercel, si cette variable n'est pas définie, le site utilise
# automatiquement le domaine de production Vercel (VERCEL_PROJECT_PRODUCTION_URL).
# À renseigner dès que le domaine définitif (ex. https://couverture-vasseur.fr) est en place.
NEXT_PUBLIC_SITE_URL=

# Envoi des demandes de devis par e-mail (facultatif).
# Sans ces variables, le formulaire enregistre la demande dans les logs du serveur
# et répond quand même « demande reçue » — le site reste déployable en l'état.
RESEND_API_KEY=
DEVIS_TO_EMAIL=contact@couverture-vasseur.fr
DEVIS_FROM_EMAIL=site@couverture-vasseur.fr
